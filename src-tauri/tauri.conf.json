{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PolyU Better Canvas",
  "version": "0.2.0",
  "identifier": "local.polyu.canvas.localized",
  "build": {
    "beforeDevCommand": "npm run native && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run native && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PolyU Better Canvas",
        "width": 1240,
        "height": 860,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": [
      "resources/NativeBridge.app",
      "resources/DocumentReader",
      "resources/NOTICE.md",
      "resources/THIRD_PARTY_LICENSES.md"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
